---
import "../styles/global.css";
import "../styles/b.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props {
  title?: string;
  description?: string;
}
const { title, description = "デジタルコミュニケーションデザイン株式会社（デコデ）。本質を捉え、アイディアで解決する。" } = Astro.props;
const full = title
  ? `${title}｜デジタルコミュニケーションデザイン株式会社`
  : "デジタルコミュニケーションデザイン株式会社（デコデ）";
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <!-- 見本の間は検索に出さない。公開前に外す -->
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/img/decode-mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header path={path} />
    <main id="top">
      <slot />
    </main>
    <Footer />
    <div class="bfix" aria-label="クイックリンク">
      <a href="/service/owned-media-360/#document">資料を申し込む<span aria-hidden="true">›</span></a>
      <a href="/contact/">お問い合わせ<span aria-hidden="true">›</span></a>
    </div>
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
