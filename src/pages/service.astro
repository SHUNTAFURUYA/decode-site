---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { services, featured } from "../data/site";
---

<Base title="事業内容" description="デコデの事業内容。AIオウンドメディア360、AI360のほか、デジタルコンテンツ開発、ツーリズムサポート、WEB広告最適化運用、Z世代マーケティングサポート、レストランマーケティングサポート。">
  <PageHero en="Service" title="事業内容" />

  <section class="sec">
    <div class="wrap">
      <p class="label sec__label fade-up">Featured</p>
      <h2 class="lead-h fade-up">AIで、オウンドメディアを動かす。</h2>
      <ul class="feat">
        {featured.map((f, i) => (
          <li class="fade-up" style={`--d:${i * 0.08}s`}>
            <a class="feat__card" href={f.href}>
              <span class="feat__tag">{f.tag}</span>
              <h3>{f.title}</h3>
              <p>{f.lead}</p>
              <span class="feat__more">詳しく見る →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec sec--soft">
    <div class="wrap">
      <p class="label sec__label fade-up">Other Service</p>
      <h2 class="lead-h fade-up">そのほかの事業</h2>
      <ul class="svc-mini">
        {services.map((s, i) => (
          <li class="fade-up" style={`--d:${(i % 2) * 0.08}s`}>
            <span class="svc-mini__no">{s.no}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="contact">
    <div class="contact__plane" aria-hidden="true"></div>
    <div class="wrap contact__in">
      <p class="label label--light fade-up">Contact</p>
      <h2 class="contact__title fade-up">まずはお気軽に、ご相談ください。</h2>
      <a class="btn btn--white fade-up" href="/contact/">お問い合わせ</a>
    </div>
  </section>
</Base>
