---
import Base from "../layouts/Base.astro";
import { services, cases, company, featured } from "../data/site";
const topServices = services;
---

<Base>
  <!-- 1. 最初の画面 -->
  <section class="hero" aria-label="デコデ">
    <div class="hero__text">
      <h1 class="hero__title fade-up">本質を捉え、<br />アイディアで<br />解決する。</h1>
      <p class="hero__en fade-up" style="--d: 0.12s">Digital Communication Design</p>
    </div>
    <div class="hero__art" aria-hidden="true">
      <div class="plane plane--a" data-par="-0.10"></div>
      <div class="plane plane--b" data-par="0.06"></div>
      <div class="hero__photo" data-par="-0.04">
        <img src="/img/hero.jpg" alt="" />
      </div>
      <div class="plane plane--c" data-par="0.12"></div>
    </div>
    <a class="hero__scroll" href="#about" aria-label="下へ">Scroll</a>
  </section>

  <!-- 2. デコデの想い -->
  <section class="statement" id="about">
    <div class="wrap statement__in">
      <p class="label fade-up">Philosophy</p>
      <p class="statement__lead fade-up">
        インターネットの登場によりコミュニケーションが複雑化しています。<br />本質を捉え、アイディアで解決していきます。
      </p>
      <p class="about__sub fade-up">
        インターネットの時代が到来して、私たちのコミュニケーションの方法は一変しました。情報は瞬時に世界中を駆け巡り、人々のつながり方、考え方、そしてビジネスの進め方までが劇的に変化しています。私たち広告会社としてのフィロソフィーは、その複雑さの中でも本質を見極めること。そして、独自のアイディアでその本質を伝え、問題を解決することにあります。
      </p>
      <a class="arrow-link fade-up" href="/philosophy/"><span class="arrow-link__c">→</span>私たちについて</a>
    </div>
  </section>

  <!-- 3. 事業内容 -->
  <section class="service" id="service">
    <div class="wrap">
      <p class="label fade-up">Service</p>
      <h2 class="h2 fade-up">事業内容</h2>
      <ul class="feat">
        {featured.map((f, i) => (
          <li class="fade-up" style={`--d:${i * 0.08}s`}>
            <a class="feat__card" href={f.href}>
              <span class="feat__tag">{f.tag}</span>
              <h3>{f.title}</h3>
              <p>{f.lead}</p>
              <span class="feat__more">詳しく見る →</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="feat__sub fade-up">そのほかの事業</p>
      <ul class="svc">
        {topServices.map((s, i) => (
          <li class="svc__item fade-up" style={`--d: ${(i % 2) * 0.08}s`}>
            <span class="svc__no">{s.no}</span>
            <h3>{s.title}</h3>
            <p>{s.body.split("。")[0]}。</p>
          </li>
        ))}
      </ul>
      <a class="arrow-link fade-up" href="/service/" style="margin-top: 40px"><span class="arrow-link__c">→</span>事業内容をすべて見る</a>
    </div>
  </section>

  <!-- 4. 事例・コラム -->
  <section class="case" id="case">
    <div class="wrap">
      <div class="case__head">
        <div>
          <p class="label fade-up">Case Study</p>
          <h2 class="h2 fade-up">事例・コラム</h2>
        </div>
        <a class="arrow-link fade-up" href="/case/"><span class="arrow-link__c">→</span>事例をすべて見る</a>
      </div>
      <ul class="cases">
        {cases.map((c, i) => (
          <li class="fade-up" style={`--d: ${i * 0.08}s`}>
            <a class="card" href={`/case/${c.slug}/`}>
              <div class={`card__img card__img--${c.tone}`}><span>写真（仮）</span></div>
              <p class="card__tag">{c.tags[0]}</p>
              <h3>{c.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. 会社概要 -->
  <section class="company" id="company">
    <div class="wrap company__in">
      <div>
        <p class="label fade-up">Company</p>
        <h2 class="h2 fade-up">会社概要</h2>
      </div>
      <div>
        <dl class="table fade-up">
          <div><dt>商号</dt><dd>{company.nameJa}</dd></div>
          <div><dt>代表者</dt><dd>{company.rep}</dd></div>
          <div><dt>設立</dt><dd>{company.founded}</dd></div>
          <div><dt>所在地</dt><dd>{company.zip} {company.address}</dd></div>
        </dl>
        <a class="arrow-link fade-up" href="/company/" style="margin-top: 32px"><span class="arrow-link__c">→</span>会社概要を見る</a>
      </div>
    </div>
  </section>

  <!-- 6. お問い合わせ -->
  <section class="contact" id="contact">
    <div class="contact__plane" aria-hidden="true"></div>
    <div class="wrap contact__in">
      <p class="label label--light fade-up">Contact</p>
      <h2 class="contact__title fade-up">まずはお気軽に、ご相談ください。</h2>
      <p class="contact__text fade-up">課題が決まっていなくても大丈夫です。</p>
      <a class="btn btn--white fade-up" href="/contact/">お問い合わせ</a>
    </div>
  </section>
</Base>
