---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { company } from "../data/site";
import { formConfig } from "../data/forms";
---

<Base title="お問い合わせ" description="デコデへのお問い合わせ。">
  <PageHero en="Contact" title="お問い合わせ" lead="記事、SNS、キャンペーン、AIの活用まで。課題が決まっていなくても大丈夫です。" />
  <section class="sec">
    <div class="wrap split">
      <div class="contact-side fade-up">
        <strong>メールでのご連絡</strong>
        <a href={`mailto:${company.email}`}>{company.email}</a>
        <strong style="margin-top: 16px">所在地</strong>
        <p>{company.zip}<br />{company.address}</p>
        <strong style="margin-top: 16px">まず資料から</strong>
        <p>相談の前に、サービスを知りたい方へ。<a class="ai-link" href="/service/owned-media-360/#document">AIオウンドメディア360の資料</a>をお送りします。</p>
      </div>
      <!-- 送り先は src/data/forms.ts の endpoint。空のあいだは「メールを作成」で info@ 宛てに開くだけ（サーバーへは送らない） -->
      <form class="form fade-up" id="contact-form" data-to={company.email} data-endpoint={formConfig.endpoint} novalidate>
        <label>お名前<span class="req">必須</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label>会社名
          <input type="text" name="company" autocomplete="organization" />
        </label>
        <label>メールアドレス<span class="req">必須</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>お問い合わせ内容<span class="req">必須</span>
          <textarea name="message" required></textarea>
        </label>
        <p class="form__note">「プライバシーポリシー」をご確認のうえ、送信してください。</p>
        <button class="btn btn--pill" type="submit">送信する</button>
        <p class="form__note" id="form-msg" role="status"></p>
      </form>
    </div>
  </section>
  <script>
    const f = document.getElementById("contact-form");
    const msg = document.getElementById("form-msg");
    f.addEventListener("submit", async (e) => {
      e.preventDefault();
      const d = new FormData(f);
      if (!d.get("name") || !d.get("email") || !d.get("message")) {
        msg.textContent = "必須の項目を入力してください。";
        return;
      }
      // 送り先（forms.ts の endpoint）が決まっていれば、そこへ送る
      if (f.dataset.endpoint) {
        try {
          const res = await fetch(f.dataset.endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              type: "contact",
              source: "contact",
              name: d.get("name"),
              company: d.get("company") || "",
              email: d.get("email"),
              message: d.get("message"),
            }),
          });
          if (!res.ok) throw new Error(String(res.status));
          f.reset();
          msg.textContent = "お問い合わせを送信しました。ありがとうございます。";
        } catch {
          msg.textContent = "送信できませんでした。時間をおいて、もう一度お試しください。";
        }
        return;
      }
      const body = `お名前：${d.get("name")}\n会社名：${d.get("company") || ""}\nメール：${d.get("email")}\n\n${d.get("message")}`;
      window.location.href = `mailto:${f.dataset.to}?subject=${encodeURIComponent("お問い合わせ")}&body=${encodeURIComponent(body)}`;
      msg.textContent = "メールソフトが開きます。開かない場合は info@dcd.co.jp へ直接ご連絡ください。";
    });
  </script>
</Base>
