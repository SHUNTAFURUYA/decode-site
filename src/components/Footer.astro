---
import { nav, company, featured } from "../data/site";
---

<footer class="foot">
  <div class="bwrap foot__in">
    <div class="foot__brand">
      <img src="/img/decode-name.png" alt={company.nameJa} width="200" height="12" />
      <p class="foot__addr">
        {company.zip}<br />{company.address}
      </p>
    </div>
    <nav class="foot__nav" aria-label="フッターメニュー">
      <div>
        <p class="foot__h">MENU</p>
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/contact/">お問い合わせ</a>
      </div>
      <div>
        <p class="foot__h">SERVICE</p>
        {featured.map((f) => <a href={f.href}>{f.title}</a>)}
        <a href="/service/">事業内容</a>
      </div>
    </nav>
  </div>
  <div class="bwrap foot__sub">
    <a href="/privacy/">&gt;PRIVACY POLICY</a>
    <p class="foot__copy">© Digital Communication Design Inc.</p>
  </div>
</footer>
